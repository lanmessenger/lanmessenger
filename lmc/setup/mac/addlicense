#!/bin/sh
set -eu

if [ "${1:-}" = "" ]; then
  echo "Usage: addlicense <Version> [arch-suffix]"
  echo "Eg: addlicense 1.0.0 x86_64"
  echo "Eg: addlicense 1.0.0 arm64"
  exit 1
fi

ARCH_SUFFIX="${2:-x86_64}"
OUT="lmc_$1_$ARCH_SUFFIX.dmg"

# Eject the volume createdisk left mounted. Retry while it is still
# mounted: Finder/Spotlight may hold it busy right after createdisk.
# A missing volume is success, not failure (it can vanish on its own
# between attempts); fail only if it is still mounted after retries.
n=0
while hdiutil info | grep -q '/Volumes/LAN-Messenger'; do
  if hdiutil detach /Volumes/LAN-Messenger; then
    break
  fi
  n=$((n + 1))
  if [ "$n" -ge 5 ]; then
    echo "detach failed 5 times, trying -force..." >&2
    if hdiutil detach /Volumes/LAN-Messenger -force; then
      break
    fi
    hdiutil info | grep -q '/Volumes/LAN-Messenger' || break
    echo "detach failed: volume still mounted" >&2
    exit 1
  fi
  echo "detach attempt $n failed (busy?), retrying in 5s..." >&2
  if [ "$n" -eq 1 ]; then
    # Best-effort: name the holder so the next flake log shows
    # the culprit instead of just "Resource busy".
    lsof +D /Volumes/LAN-Messenger 2>/dev/null || true
  fi
  sleep 5
done

# The mountpoint can vanish from hdiutil info while the device is still
# busy (lazy eject); converting immediately then fails with
# "Resource temporarily unavailable". Wait until the image is gone too.
n=0
while hdiutil info 2>/dev/null | grep -q 'LAN-Messenger'; do
  n=$((n + 1))
  if [ "$n" -ge 6 ]; then
    echo "image still attached after 30s, continuing anyway..." >&2
    break
  fi
  sleep 5
done

sync

# Compress the disk image. -ov keeps reruns idempotent; without set -e
# a failure here used to be masked and surfaced only as a missing
# artifact in the Upload packages step. Convert itself is retried: the
# device can still be busy right after the volume is gone (lazy eject).
n=0
until hdiutil convert LAN-Messenger.dmg -format UDBZ -ov -o "$OUT"; do
  n=$((n + 1))
  if [ "$n" -ge 3 ]; then
    echo "convert failed 3 times, giving up" >&2
    exit 1
  fi
  echo "convert attempt $n failed, retrying in 10s..." >&2
  sleep 10
done
test -f "$OUT" || { echo "convert produced no $OUT" >&2; exit 1; }
ls -lh "$OUT"

# Add the license to the disk image (best-effort)
python3 ./licenseDMG.py "$OUT" ./package/eula/license.txt || echo "WARNING: license embedding failed (non-fatal)" >&2
test -f "$OUT" || { echo "dmg missing after license step: $OUT" >&2; exit 1; }

# Move the final image to output folder
mv -f -v "$OUT" ../
test -f "../$OUT" || { echo "move produced no ../$OUT" >&2; exit 1; }
ls -lh "../$OUT"

# Delete the intermediate files
rm -r -v LAN-Messenger.app
rm -f -v LAN-Messenger.dmg

exit 0
