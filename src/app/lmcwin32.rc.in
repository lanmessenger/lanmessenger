#include <windows.h>

IDI_MAIN_ICON   ICON    DISCARDABLE "@LMC_RC_ICO_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION	@LMC_RC_NUMERIC@
PRODUCTVERSION	@LMC_RC_NUMERIC@
FILEFLAGSMASK	VS_FFI_FILEFLAGSMASK
#ifdef DEBUG
FILEFLAGS	VER_DEBUG
#else
FILEFLAGS	0x0L
#endif
FILEOS          VOS__WINDOWS32
FILETYPE	VFT_APP
FILESUBTYPE     0x0L
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904b0"
        {
            VALUE "Comments",         "\0"
            VALUE "CompanyName",      "LAN Messenger\0"
            VALUE "FileDescription",  "LAN Messenger\0"
            VALUE "FileVersion",      "@LMC_RC_VERSION_STR@\0"
            VALUE "InternalName",     "lanmsngr\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 LAN Messenger Project.\0"
            VALUE "OriginalFilename", "lmc.exe\0"
            VALUE "ProductName",      "LAN Messenger\0"
            VALUE "ProductVersion",   "@LMC_RC_VERSION_STR@\0"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1200
    }
}
