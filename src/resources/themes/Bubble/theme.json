{
  "version": 1,
  "_comment": "layout_* reserved since stage 1, read from stage 2; ship all 5 layout_*. The S example uses existing blocks only (linkPreview/quote/code/buttons are reserved for L)",
  "bubble": {
    "radius": [12, 12, 12, 4],
    "radiusFirstInGroup": [12, 12, 12, 4],
    "radiusNextInGroup": [4, 12, 12, 4],
    "tail": 8,
    "shadow": [0, 2, 8, 0.18],
    "padding": [8, 10, 8, 10],
    "margin": 6,
    "marginFirstInGroup": 6,
    "marginNextInGroup": 2,
    "maxWidthPct": 75
  },
  "viewPadding": [0, 8, 8, 8],
  "avatar": {
    "size": 40,
    "shape": "circle",
    "showOnGrouped": false,
    "gap": 8
  },
  "header": {
    "senderBold": true,
    "gap": 2,
    "timeFormat": "HH:mm"
  },
  "light": {
    "bubbleIn": "#FFFFFF",
    "bubbleIn2": "#F1F4F8",
    "bubbleOut": "#D9F2C7",
    "bubbleOut2": "#C9E8B4",
    "text": "#1A1D21",
    "secondary": "#6B7280",
    "link": "#0B5FFF",
    "border": "#D8DEE5",
    "page": "#EDEFF2",
    "accent": "#2F9E44",
    "accentSoft": "#E6F4EA",
    "textInverse": "#1A1D21"
  },
  "dark": {
    "bubbleIn": "#1F242B",
    "bubbleIn2": "#262D36",
    "bubbleOut": "#1D4D2B",
    "bubbleOut2": "#1A4527",
    "text": "#E8EAED",
    "secondary": "#9AA0A6",
    "link": "#8AB4F8",
    "border": "#3A424C",
    "page": "#131518",
    "accent": "#3FB950",
    "accentSoft": "#1A2E22",
    "textInverse": "#E8EAED"
  },
  "cards": {
    "incoming": {
      "bg": "$bubbleIn",
      "bg2": "$bubbleIn2",
      "tail": "left",
      "avatar": true
    },
    "outgoing": {
      "bg": "$bubbleOut",
      "bg2": "$bubbleOut2",
      "tail": "right",
      "avatar": false
    },
    "broadcast": {
      "bg": "$accentSoft",
      "bg2": "$accentSoft",
      "border": "$accent",
      "tail": "none"
    },
    "system": {
      "bg": "transparent",
      "align": "center",
      "text": "$secondary"
    },
    "request": {
      "bg": "$bubbleIn",
      "bg2": "$bubbleIn2",
      "border": "$border",
      "tail": "left"
    }
  },
  "layout_incoming": [
    {
      "type": "hbox",
      "gap": 8,
      "children": [
        {
          "type": "avatar"
        },
        {
          "type": "vbox",
          "stretch": 1,
          "children": [
            {
              "type": "header",
              "items": ["sender", "time"],
              "ifNot": "isGrouped"
            },
            {
              "type": "bubble",
              "card": "incoming",
              "children": [
                {
                  "type": "body"
                },
                {
                  "type": "fileCard",
                  "if": "isFile"
                }
              ]
            },
            {
              "type": "status",
              "if": "isOwnLast"
            }
          ]
        }
      ]
    }
  ],
  "layout_outgoing": [
    {
      "type": "hbox",
      "gap": 8,
      "children": [
        {
          "type": "vbox",
          "stretch": 1,
          "children": [
            {
              "type": "header",
              "items": ["time"],
              "ifNot": "isGrouped"
            },
            {
              "type": "bubble",
              "card": "outgoing",
              "children": [
                {
                  "type": "body"
                },
                {
                  "type": "fileCard",
                  "if": "isFile"
                }
              ]
            },
            {
              "type": "status",
              "if": "isOwnLast"
            }
          ]
        }
      ]
    }
  ],
  "layout_system": [
    {
      "type": "vbox",
      "children": [
        {
          "type": "bubble",
          "card": "system",
          "children": [
            {
              "type": "body"
            }
          ]
        }
      ]
    }
  ],
  "layout_broadcast": [
    {
      "type": "vbox",
      "children": [
        {
          "type": "bubble",
          "card": "broadcast",
          "children": [
            {
              "type": "body"
            }
          ]
        }
      ]
    }
  ],
  "layout_request": [
    {
      "type": "vbox",
      "children": [
        {
          "type": "bubble",
          "card": "request",
          "children": [
            {
              "type": "body"
            },
            {
              "type": "fileCard",
              "if": "isFile"
            }
          ]
        }
      ]
    }
  ]
}
