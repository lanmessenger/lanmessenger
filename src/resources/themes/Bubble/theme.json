{
  "version": 1,
  "_comment": "layout_* reserved since stage 1, read from stage 2; ship all 5 layout_*. The S example uses existing blocks only (linkPreview/quote/code/buttons are reserved for L)",
  "viewPadding": [0, 8, 8, 8],
  "avatar": {
    "size": 40,
    "shape": "circle",
    "showOnGrouped": false
  },
  "header": {
    "senderBold": true,
    "timeFormat": "HH:mm",
    "senderColor": ["#6B7280", "#9AA0A6"],
    "timeColor": ["#6B7280", "#9AA0A6"]
  },
  "text": ["#1A1D21", "#E8EAED"],
  "link": ["#0B5FFF", "#8AB4F8"],
  "page": ["#EDEFF2", "#131518"],
  "layout_incoming": [
    {
      "type": "hbox",
      "gap": 8,
      "children": [
        {
          "type": "avatar"
        },
        {
          "type": "vbox",
          "gap": 2,
          "stretch": 1,
          "children": [
            {
              "type": "header",
              "items": ["sender", "time"],
              "ifNot": "isGrouped"
            },
            {
              "type": "body",
              "corners": {
                "default": [12, 12, 12, 4],
                "next": [4, 12, 12, 4]
              },
              "bg": ["gradient(#FFFFFF, #F1F4F8)", "gradient(#1F242B, #262D36)"],
              "padding": [8, 10, 8, 10],
              "shadow": [0, 2, 8, 0.18],
              "margin": {"default": 6, "next": 2}, "maxWidthPct": 75
            },
            {
              "type": "status",
              "if": "isOwnLast"
            }
          ]
        }
      ]
    }
  ],
  "layout_outgoing": [
    {
      "type": "hbox",
      "gap": 8,
      "children": [
        {
          "type": "vbox",
          "gap": 2,
          "stretch": 1,
          "children": [
            {
              "type": "header",
              "items": ["time"],
              "ifNot": "isGrouped"
            },
            {
              "type": "body",
              "corners": {
                "default": [12, 12, 4, 12],
                "next": [12, 4, 4, 12]
              },
              "bg": ["gradient(#D9F2C7, #C9E8B4)", "gradient(#1D4D2B, #1A4527)"],
              "padding": [8, 10, 8, 10],
              "shadow": [0, 2, 8, 0.18],
              "margin": {"default": 6, "next": 2}, "maxWidthPct": 75
            },
            {
              "type": "status",
              "if": "isOwnLast"
            }
          ]
        }
      ]
    }
  ],
  "layout_system": [
    {
      "type": "vbox",
      "gap": 0,
      "children": [
        {
          "type": "body",
          "bg": "transparent",
          "textColor": ["#6B7280", "#9AA0A6"],
          "padding": [8, 10, 8, 10],
          "shadow": [0, 2, 8, 0.18],
          "margin": {"default": 6, "next": 2}, "maxWidthPct": 75
        }
      ]
    }
  ],
  "layout_broadcast": [
    {
      "type": "vbox",
      "gap": 0,
      "children": [
        {
          "type": "body",
          "bg": ["#E6F4EA", "#1A2E22"],
          "border": ["#2F9E44", "#3FB950"],
          "padding": [8, 10, 8, 10],
          "shadow": [0, 2, 8, 0.18],
          "margin": {"default": 6, "next": 2}, "maxWidthPct": 75
        }
      ]
    }
  ],
  "layout_request": [
    {
      "type": "vbox",
      "gap": 0,
      "children": [
        {
          "type": "fileCard",
          "bg": ["gradient(#FFFFFF, #F1F4F8)", "gradient(#1F242B, #262D36)"],
          "border": ["#D8DEE5", "#3A424C"],
          "padding": [8, 10, 8, 10],
          "shadow": [0, 2, 8, 0.18],
          "margin": {"default": 6, "next": 2}, "maxWidthPct": 75
        }
      ]
    }
  ]
}
