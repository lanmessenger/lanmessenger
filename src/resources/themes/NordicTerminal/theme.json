{
  "version": 1,
  "_comment": "Compact Nordic Terminal from Stitch spec (Variant 3). Flat cards: no tail, no shadow. Spec series gap 1.5px rounded to 2 (schema requires ints). Avatar 20px from the geometry table (header strip says 22px). Time with seconds per mock. Outgoing body uses textInverse.",
  "bubble": {
    "radius": [6, 6, 6, 6],
    "radiusFirstInGroup": [6, 6, 6, 6],
    "radiusNextInGroup": [2, 6, 6, 6],
    "tail": 0,
    "tailStyle": "none",
    "shadow": [0, 0, 0, 0],
    "padding": [8, 10, 8, 10],
    "margin": 5,
    "marginFirstInGroup": 5,
    "marginNextInGroup": 2,
    "maxWidthPct": 88
  },
  "viewPadding": [0, 8, 8, 8],
  "avatar": {
    "size": 20,
    "shape": "square",
    "showOnGrouped": false,
    "gap": 8
  },
  "header": {
    "senderBold": true,
    "gap": 2,
    "senderColor": "$text",
    "timeFormat": "HH:mm:ss",
    "outgoingYouLabel": true
  },
  "light": {
    "bubbleIn": "#F8FAFC",
    "bubbleIn2": "#F1F5F9",
    "bubbleOut": "#334155",
    "bubbleOut2": "#1E293B",
    "text": "#0F172A",
    "secondary": "#64748B",
    "link": "#0284C7",
    "border": "#CBD5E1",
    "page": "#FFFFFF",
    "accent": "#EF4444",
    "accentSoft": "#FEF2F2",
    "textInverse": "#F8FAFC",
    "pill": "#F1F5F9",
    "pillBorder": "#CBD5E1"
  },
  "dark": {
    "bubbleIn": "#1C2127",
    "bubbleIn2": "#171A1F",
    "bubbleOut": "#475569",
    "bubbleOut2": "#334155",
    "text": "#E5E7EB",
    "secondary": "#9CA3AF",
    "link": "#38BDF8",
    "border": "#2D3748",
    "page": "#121417",
    "accent": "#DC2626",
    "accentSoft": "#450A0A",
    "textInverse": "#FFFFFF",
    "pill": "#111827",
    "pillBorder": "#1F2937"
  },
  "cards": {
    "incoming": {
      "bg": "$bubbleIn",
      "bg2": "$bubbleIn2",
      "tail": "left",
      "avatar": true
    },
    "outgoing": {
      "bg": "$bubbleOut",
      "bg2": "$bubbleOut2",
      "text": "$textInverse",
      "tail": "right",
      "avatar": false
    },
    "broadcast": {
      "bg": "$accentSoft",
      "bg2": "$accentSoft",
      "border": "$accent",
      "tail": "none"
    },
    "system": {
      "bg": "$pill",
      "border": "$pillBorder",
      "align": "center",
      "text": "$secondary"
    },
    "request": {
      "bg": "$bubbleIn",
      "bg2": "$bubbleIn2",
      "border": "$border",
      "tail": "left"
    }
  },
  "layout_incoming": [
    {
      "type": "hbox",
      "gap": 8,
      "children": [
        {
          "type": "avatar"
        },
        {
          "type": "vbox",
          "stretch": 1,
          "children": [
            {
              "type": "header",
              "items": ["sender", "time"],
              "ifNot": "isGrouped"
            },
            {
              "type": "bubble",
              "card": "incoming",
              "children": [
                {
                  "type": "body"
                },
                {
                  "type": "fileCard",
                  "if": "isFile"
                }
              ]
            },
            {
              "type": "status",
              "if": "isOwnLast"
            }
          ]
        }
      ]
    }
  ],
  "layout_outgoing": [
    {
      "type": "hbox",
      "gap": 8,
      "children": [
        {
          "type": "vbox",
          "stretch": 1,
          "children": [
            {
              "type": "header",
              "items": ["time"],
              "ifNot": "isGrouped"
            },
            {
              "type": "bubble",
              "card": "outgoing",
              "children": [
                {
                  "type": "body"
                },
                {
                  "type": "fileCard",
                  "if": "isFile"
                }
              ]
            },
            {
              "type": "status",
              "if": "isOwnLast"
            }
          ]
        }
      ]
    }
  ],
  "layout_system": [
    {
      "type": "vbox",
      "children": [
        {
          "type": "bubble",
          "card": "system",
          "children": [
            {
              "type": "body"
            }
          ]
        }
      ]
    }
  ],
  "layout_broadcast": [
    {
      "type": "vbox",
      "children": [
        {
          "type": "bubble",
          "card": "broadcast",
          "children": [
            {
              "type": "body"
            }
          ]
        }
      ]
    }
  ],
  "layout_request": [
    {
      "type": "vbox",
      "children": [
        {
          "type": "bubble",
          "card": "request",
          "children": [
            {
              "type": "body"
            },
            {
              "type": "fileCard",
              "if": "isFile"
            }
          ]
        }
      ]
    }
  ]
}
