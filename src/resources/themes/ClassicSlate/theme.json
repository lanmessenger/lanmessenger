{
  "version": 1,
  "_comment": "Classic Native Slate from Stitch spec (Variant 1). Single radius array: incoming corners kept, outgoing approximated by renderer (uniform radius[0] in S). Shadow opacity is shared for light/dark: light spec 0.05 used. Outgoing body uses textInverse.",
  "bubble": {
    "radius": [12, 12, 12, 2],
    "tail": 2,
    "tailStyle": "rounded",
    "shadow": [0, 1, 2, 0.05],
    "padding": [10, 12, 10, 12],
    "margin": 8,
    "marginFirstInGroup": 8,
    "marginNextInGroup": 2,
    "maxWidthPct": 84
  },
  "viewPadding": [0, 8, 8, 8],
  "avatar": {
    "size": 28,
    "shape": "circle",
    "showOnGrouped": false,
    "gap": 8
  },
  "header": {
    "senderBold": true,
    "gap": 2,
    "senderColor": "$text",
    "timeFormat": "HH:mm",
    "outgoingYouLabel": true
  },
  "light": {
    "bubbleIn": "#FFFFFF",
    "bubbleIn2": "#F8F9FA",
    "bubbleOut": "#2563EB",
    "bubbleOut2": "#1D4ED8",
    "text": "#1E293B",
    "secondary": "#64748B",
    "link": "#2563EB",
    "border": "#CBD5E1",
    "page": "#F4F5F7",
    "accent": "#F59E0B",
    "accentSoft": "#FEF3C7",
    "textInverse": "#FFFFFF",
    "pill": "#E8EDF2",
    "pillBorder": "#E2E8F0"
  },
  "dark": {
    "bubbleIn": "#1E293B",
    "bubbleIn2": "#172033",
    "bubbleOut": "#3B82F6",
    "bubbleOut2": "#2563EB",
    "text": "#F1F5F9",
    "secondary": "#94A3B8",
    "link": "#60A5FA",
    "border": "#334155",
    "page": "#0F172A",
    "accent": "#B45309",
    "accentSoft": "#451A03",
    "textInverse": "#FFFFFF",
    "pill": "#1E293B",
    "pillBorder": "#334155"
  },
  "cards": {
    "incoming": {
      "bg": "$bubbleIn",
      "bg2": "$bubbleIn2",
      "tail": "left",
      "avatar": true
    },
    "outgoing": {
      "bg": "$bubbleOut",
      "bg2": "$bubbleOut2",
      "text": "$textInverse",
      "tail": "right",
      "avatar": false
    },
    "broadcast": {
      "bg": "$accentSoft",
      "bg2": "$accentSoft",
      "border": "$accent",
      "tail": "none"
    },
    "system": {
      "bg": "$pill",
      "border": "$pillBorder",
      "align": "center",
      "text": "$secondary"
    },
    "request": {
      "bg": "$bubbleIn",
      "bg2": "$bubbleIn2",
      "border": "$border",
      "tail": "left"
    }
  },
  "layout_incoming": [
    {
      "type": "hbox",
      "gap": 8,
      "children": [
        {
          "type": "avatar"
        },
        {
          "type": "vbox",
          "stretch": 1,
          "children": [
            {
              "type": "header",
              "items": ["sender", "time"],
              "ifNot": "isGrouped"
            },
            {
              "type": "bubble",
              "card": "incoming",
              "children": [
                {
                  "type": "body"
                },
                {
                  "type": "fileCard",
                  "if": "isFile"
                }
              ]
            },
            {
              "type": "status",
              "if": "isOwnLast"
            }
          ]
        }
      ]
    }
  ],
  "layout_outgoing": [
    {
      "type": "hbox",
      "gap": 8,
      "children": [
        {
          "type": "vbox",
          "stretch": 1,
          "children": [
            {
              "type": "header",
              "items": ["time"],
              "ifNot": "isGrouped"
            },
            {
              "type": "bubble",
              "card": "outgoing",
              "children": [
                {
                  "type": "body"
                },
                {
                  "type": "fileCard",
                  "if": "isFile"
                }
              ]
            },
            {
              "type": "status",
              "if": "isOwnLast"
            }
          ]
        }
      ]
    }
  ],
  "layout_system": [
    {
      "type": "vbox",
      "children": [
        {
          "type": "bubble",
          "card": "system",
          "children": [
            {
              "type": "body"
            }
          ]
        }
      ]
    }
  ],
  "layout_broadcast": [
    {
      "type": "vbox",
      "children": [
        {
          "type": "bubble",
          "card": "broadcast",
          "children": [
            {
              "type": "body"
            }
          ]
        }
      ]
    }
  ],
  "layout_request": [
    {
      "type": "vbox",
      "children": [
        {
          "type": "bubble",
          "card": "request",
          "children": [
            {
              "type": "body"
            },
            {
              "type": "fileCard",
              "if": "isFile"
            }
          ]
        }
      ]
    }
  ]
}
