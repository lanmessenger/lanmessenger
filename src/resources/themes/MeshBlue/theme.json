{
  "version": 1,
  "_comment": "Modern Mesh Blue from Stitch spec (Variant 2). Corners are explicit per layout: outgoing nodes carry hand-mirrored values. Cyan shadow tint is not supported by the renderer (black shadow); opacity is shared for light/dark. Outgoing body text is #FFFFFF both modes.",
  "viewPadding": [0, 8, 8, 8],
  "avatar": {
    "size": 26,
    "shape": "rounded",
    "showOnGrouped": false
  },
  "header": {
    "senderBold": true,
    "timeFormat": "HH:mm",
    "outgoingYouLabel": true,
    "senderColor": ["#64748B", "#7DD3FC"],
    "timeColor": ["#64748B", "#7DD3FC"]
  },
  "text": ["#0F172A", "#E2E8F0"],
  "link": ["#0284C7", "#38BDF8"],
  "page": ["#EFF6FF", "#0B1320"],
  "layout_incoming": [
    {
      "type": "hbox",
      "gap": 8,
      "children": [
        {
          "type": "avatar"
        },
        {
          "type": "vbox",
          "gap": 2,
          "stretch": 1,
          "children": [
            {
              "type": "header",
              "items": ["sender", "time"],
              "senderColor": ["#0F172A", "#E2E8F0"],
              "ifNot": "isGrouped"
            },
            {
              "type": "body",
              "corners": {
                "default": [14, 14, 14, 3],
                "next": [3, 14, 14, 3]
              },
              "bg": ["gradient(#FFFFFF, #F0FDF4)", "gradient(#162235, #111A29)"],
              "padding": [10, 14, 10, 14],
              "shadow": [0, 2, 4, 0.08],
              "margin": {"default": 9, "next": 3}, "maxWidthPct": 80
            },
            {
              "type": "status",
              "if": "isOwnLast"
            }
          ]
        }
      ]
    }
  ],
  "layout_outgoing": [
    {
      "type": "hbox",
      "gap": 8,
      "children": [
        {
          "type": "vbox",
          "gap": 2,
          "stretch": 1,
          "children": [
            {
              "type": "header",
              "items": ["time"],
              "senderColor": ["#0F172A", "#E2E8F0"],
              "ifNot": "isGrouped"
            },
            {
              "type": "body",
              "corners": {
                "default": [14, 14, 3, 14],
                "next": [14, 3, 3, 14]
              },
              "bg": ["gradient(#0284C7, #0369A1)", "gradient(#0EA5E9, #0284C7)"],
              "textColor": "#FFFFFF",
              "padding": [10, 14, 10, 14],
              "shadow": [0, 2, 4, 0.08],
              "margin": {"default": 9, "next": 3}, "maxWidthPct": 80
            },
            {
              "type": "status",
              "if": "isOwnLast"
            }
          ]
        }
      ]
    }
  ],
  "layout_system": [
    {
      "type": "vbox",
      "gap": 0,
      "children": [
        {
          "type": "body",
          "bg": ["#E0F2FE", "#082F49"],
          "textColor": ["#64748B", "#7DD3FC"],
          "border": ["#BAE6FD", "#075985"],
          "padding": [10, 14, 10, 14],
          "shadow": [0, 2, 4, 0.08],
          "margin": {"default": 9, "next": 3}, "maxWidthPct": 80
        }
      ]
    }
  ],
  "layout_broadcast": [
    {
      "type": "vbox",
      "gap": 0,
      "children": [
        {
          "type": "body",
          "bg": ["#EFF6FF", "#082F49"],
          "border": "#0284C7",
          "padding": [10, 14, 10, 14],
          "shadow": [0, 2, 4, 0.08],
          "margin": {"default": 9, "next": 3}, "maxWidthPct": 80
        }
      ]
    }
  ],
  "layout_request": [
    {
      "type": "vbox",
      "gap": 0,
      "children": [
        {
          "type": "fileCard",
          "bg": ["gradient(#FFFFFF, #F0FDF4)", "gradient(#162235, #111A29)"],
          "border": ["#BAE6FD", "#1E3A5F"],
          "padding": [10, 14, 10, 14],
          "shadow": [0, 2, 4, 0.08],
          "margin": {"default": 9, "next": 3}, "maxWidthPct": 80
        }
      ]
    }
  ]
}
