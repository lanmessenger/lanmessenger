<RCC>
    <qresource prefix="/icons">
        <file alias="application">resources/icons/lmc.ico</file>
    </qresource>
    <qresource prefix="/icons/bubbles">
        <file alias="away">resources/icons/awaybubble.ico</file>
        <file alias="busy">resources/icons/busybubble.ico</file>
        <file alias="nodisturb">resources/icons/nodisturbbubble.ico</file>
        <file alias="offline">resources/icons/offlinebubble.ico</file>
        <file alias="online">resources/icons/onlinebubble.ico</file>
    </qresource>
    <qresource prefix="/images">
        <file alias="close">resources/images/close.png</file>
        <file alias="history">resources/images/history.png</file>
        <file alias="info">resources/images/info.png</file>
        <file alias="messenger">resources/images/messenger.png</file>
        <file alias="tools">resources/images/tools.png</file>
        <file alias="file">resources/images/file.png</file>
        <file alias="font">resources/images/font.png</file>
        <file alias="fontcolor">resources/images/fontcolor.png</file>
        <file alias="smiley">resources/images/smiley.png</file>
        <file alias="save">resources/images/save.png</file>
        <file alias="paint">resources/images/paint.png</file>
        <file alias="logo">resources/images/logo.png</file>
        <file alias="pixel">resources/images/pixel.png</file>
        <file alias="critical">resources/images/critical.png</file>
        <file alias="accept">resources/images/accept.png</file>
        <file alias="stop">resources/images/stop.png</file>
        <file alias="folder">resources/images/folder.png</file>
        <file alias="broadcastmsg">resources/images/broadcastmsg.png</file>
        <file alias="criticalmsg">resources/images/criticalmsg.png</file>
        <file alias="filemsg">resources/images/filemsg.png</file>
        <file alias="systemsettings">resources/images/systemsettings.png</file>
        <file alias="alertsettings">resources/images/alertsettings.png</file>
        <file alias="historysettings">resources/images/historysettings.png</file>
        <file alias="messagesettings">resources/images/messagesettings.png</file>
        <file alias="networksettings">resources/images/networksettings.png</file>
        <file alias="transfersettings">resources/images/transfersettings.png</file>
        <file alias="usersettings">resources/images/usersettings.png</file>
        <file alias="transfer">resources/images/transfer.png</file>
        <file alias="logosmall">resources/images/logosmall.png</file>
        <file alias="web">resources/images/web.png</file>
        <file alias="refresh">resources/images/refresh.png</file>
        <file alias="question">resources/images/question.png</file>
        <file alias="themesettings">resources/images/themesettings.png</file>
        <file alias="chat">resources/images/chat.png</file>
        <file alias="vgrip">resources/images/vgrip.png</file>
        <file alias="hgrip">resources/images/hgrip.png</file>
        <file alias="hotkeysettings">resources/images/hotkeysettings.png</file>
