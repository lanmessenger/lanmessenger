        <file alias="newchatroom">resources/images/newchatroom.png</file>
        <file alias="play">resources/images/play.png</file>
        <file alias="sendfolder">resources/images/sendfolder.png</file>
    </qresource>
    <qresource prefix="/images/status">
        <file alias="away">resources/images/away.png</file>
        <file alias="busy">resources/images/busy.png</file>
        <file alias="nodisturb">resources/images/nodisturb.png</file>
        <file alias="offline">resources/images/offline.png</file>
        <file alias="online">resources/images/online.png</file>
    </qresource>
    <qresource prefix="/avatars">
        <file alias="default">resources/avatars/default.png</file>
        <file alias="0">resources/avatars/0.png</file>
        <file alias="1">resources/avatars/1.png</file>
        <file alias="2">resources/avatars/2.png</file>
